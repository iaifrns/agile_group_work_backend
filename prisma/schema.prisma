generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id           String         @id @default(uuid())
  firstName    String
  lastName     String
  email        String         @unique
  password     String
  phoneNumber  String
  classLevel   String?
  groupMembers GroupMembers[]
  feedBack FeedBack[]
  Tasks Task[]
  notifications Notification[]
}

model GroupMembers {
  id         String      @id @default(uuid())
  student_id String
  group_id   String
  status     GroupStatus
  group      Group       @relation(fields: [group_id], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model Group {
  id           String         @id @default(uuid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  admin        String
  groupMembers GroupMembers[]
}

model Task {
  id String @id @default(uuid())
  title String
  desc String
  status TaskStatus
  category TaskCategory
  type TaskType
  students Student[]
  feedBack FeedBack[]
}

model FeedBack {
  id String @id @default(uuid())
  message String
  studentId String
  taskId String
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Notification {
  id String @id @default(uuid())
  message String
  students Student[]
  isRead String[]
  navigate String
  createdAt DateTime @default(now())
}

enum GroupStatus {
  REQUEST
  MEMBER
}

enum TaskStatus {
  TODO
  INPROGRESS
  DONE
}

enum TaskCategory {
  READING
  EXERCISE 
  REVISION 
  PROJECT_WORK
}

enum TaskType {
  PERSONAL
  GROUP
}

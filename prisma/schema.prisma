// Feedback model with timestamp for chronological sorting
model FeedBack {
  id        String   @id @default(uuid())
  message   String
  studentId String
  taskId    String
  createdAt DateTime @default(now()) // Enables sorting feedback from newest to oldest

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

// Notification model for system alerts and messages
model Notification {
  id        String   @id @default(uuid())
  message   String
  students  Student[]
  isRead    String[] @default([]) // Tracks which students have read the notification
  navigate  String   // Navigation path/route when notification is clicked
  createdAt DateTime @default(now())
}

// Schedule/event model for calendar items
model Schedule {
  id       String   @id @default(uuid())
  title    String
  desc     String
  createAt DateTime @default(now())
  date     DateTime
  group_id String?
  user_id  String
  group    Group?   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user     Student  @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

// Group membership request status
enum GroupStatus {
  REQUEST  // Pending approval
  MEMBER   // Approved member
}

// Task completion status
enum TaskStatus {
  TODO
  INPROGRESS
  DONE
}

// Task subject category
enum TaskCategory {
  READING
  EXERCISE
  REVISION
  PROJECT_WORK
}

// Task scope - personal or collaborative
enum TaskType {
  PERSONAL
  GROUP
}
// Prisma client generator configuration
generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// PostgreSQL database configuration
datasource db {
  provider = "postgresql"
}

// Student/User model representing a learner in the system
model Student {
  id           String         @id @default(uuid())
  firstName    String
  lastName     String
  email        String         @unique
  password     String
  phoneNumber  String
  classLevel   String?
  groupMembers GroupMembers[]
  feedBack     FeedBack[]
  notifications Notification[]
  tasks        Task[]         @relation("TaskToStudent")
  schedule     Schedule[]
}

// Junction table for many-to-many relationship between Student and Group
model GroupMembers {
  id         String      @id @default(uuid())
  student_id String
  group_id   String
  status     GroupStatus
  group      Group       @relation(fields: [group_id], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

// Study group model with admin and members
model Group {
  id           String         @id @default(uuid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  admin        String
  groupMembers GroupMembers[]
  tasks        Task[]
  schedules    Schedule[]
}

// Task/assignment model for both personal and group tasks
model Task {
  id       String   @id @default(uuid())
  title    String
  desc     String
  status   TaskStatus
  category TaskCategory
  type     TaskType
  groupId  String?
  students Student[] @relation("TaskToStudent")
  feedBack FeedBack[]
  group    Group?    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  dueDate  DateTime
}


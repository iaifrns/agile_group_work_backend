generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Student {
  id           String         @id @default(uuid())
  firstName    String
  lastName     String
  email        String         @unique
  password     String
  phoneNumber  String
  classLevel   String?
  groupMembers GroupMembers[]
}

model GroupMembers {
  id         String      @id @default(uuid())
  student_id String
  group_id   String
  status     GroupStatus
  group      Group       @relation(fields: [group_id], references: [id], onDelete: Cascade)
  student    Student     @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model Group {
  id           String         @id @default(uuid())
  name         String         @unique
  createdAt    DateTime       @default(now())
  admin        String
  groupMembers GroupMembers[]
}

enum GroupStatus {
  REQUEST
  MEMBER
}

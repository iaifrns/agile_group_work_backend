model FeedBack {
  id        String   @id @default(uuid())
  message   String
  studentId String
  taskId    String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Notification {
  id String @id @default(uuid())
  message String
  students Student[]
  isRead String[] @default([])
  navigate String
  createdAt DateTime @default(now())
}

model Schedule {
  id String @id @default(uuid())
  title String
  desc String
  createAt DateTime @default(now())
  date DateTime
  group_id String?
  user_id String
  group Group? @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user Student @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum GroupStatus {
  REQUEST
  MEMBER
}

enum TaskStatus {
  TODO
  INPROGRESS
  DONE
}

enum TaskCategory {
  READING
  EXERCISE 
  REVISION 
  PROJECT_WORK
}

enum TaskType {
  PERSONAL
  GROUP
}
